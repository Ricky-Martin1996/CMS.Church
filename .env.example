# ChurchOS environment variables
# Copy to `.env` / `.env.local` and fill in real values.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Local example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/churchos?schema=public"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/churchos?schema=public"

# -----------------------------------------------------------------------------
# Clerk Authentication
# https://dashboard.clerk.com → API Keys
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxx"
CLERK_WEBHOOK_SECRET="whsec_xxxxxxxx"

# Clerk route helpers (optional — defaults match our app routes)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"

# -----------------------------------------------------------------------------
# Security notes
# -----------------------------------------------------------------------------
# - Never commit real secrets. `.env*` is gitignored except `.env.example`.
# - CLERK_WEBHOOK_SECRET must match the Svix signing secret from Clerk.
# - DATABASE_URL should use a least-privilege DB user in production.
# - Private uploads are stored under `.data/uploads` (not under `public/`).
# - NEXT_PUBLIC_* values are exposed to the browser — do not put secrets there.
