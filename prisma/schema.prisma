// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Platform / tenancy
// =============================================================================

enum Role {
  SUPER_ADMIN
  CHURCH_ADMIN
  PASTOR
  CELL_LEADER
  VOLUNTEER_LEADER
  FINANCE_MANAGER
  MEMBER
  GUEST
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

/// Global user identity, synced from Clerk.
model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String
  firstName   String?
  lastName    String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships      Membership[]
  authoredNotes    MemberNote[]       @relation("NoteAuthor")
  authoredActivity MemberActivity[]   @relation("ActivityActor")
  savedFilters     SavedMemberFilter[]
  listPreferences  MemberListPreference[]
  savedHouseholdFilters SavedHouseholdFilter[]
  householdListPreferences HouseholdListPreference[]

  @@index([email])
  @@map("users")
}

/// Tenant boundary. Every domain record must belong to an Organization.
model Organization {
  id         String   @id @default(cuid())
  clerkOrgId String?  @unique
  name       String
  slug       String   @unique
  imageUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  memberships      Membership[]
  members          Member[]
  tags             Tag[]
  households       Household[]
  memberNotes      MemberNote[]
  memberDocuments  MemberDocument[]
  memberActivities MemberActivity[]
  attendance       AttendanceRecord[]
  givingRecords    GivingRecord[]
  prayerRequests   PrayerRequest[]
  volunteerRoles   VolunteerAssignment[]
  savedFilters     SavedMemberFilter[]
  listPreferences  MemberListPreference[]
  householdActivities HouseholdActivity[]
  householdNotes   HouseholdNote[]
  householdDocuments HouseholdDocument[]
  savedHouseholdFilters SavedHouseholdFilter[]
  householdListPreferences HouseholdListPreference[]
  attendanceSessions AttendanceSession[]
  visitors         Visitor[]
  visitorAttendances VisitorAttendance[]
  visitorJourneys  VisitorJourney[]
  visitorStageConfigs VisitorStageConfig[]
  followUpTasks    FollowUpTask[]
  communicationLogs CommunicationLog[]
  visitorStatusHistory VisitorStatusHistory[]
  visitorActivities VisitorActivity[]
  ministries       Ministry[]
  ministryRoles    MinistryRole[]
  volunteerProfiles VolunteerProfile[]
  scheduleEvents   ScheduleEvent[]
  scheduleSlots    ScheduleSlot[]
  scheduleAssignments ScheduleAssignment[]
  scheduleSwapRequests ScheduleSwapRequest[]
  volunteerCheckIns VolunteerCheckIn[]
  volunteerMessages VolunteerMessage[]
  volunteerActivities VolunteerActivity[]
  volunteerSkills  VolunteerSkill[]
  volunteerCertifications VolunteerCertification[]
  volunteerAvailabilities VolunteerAvailability[]
  volunteerMinistryPrefs VolunteerMinistryPreference[]
  churchEvents     ChurchEvent[]
  eventRegistrations EventRegistration[]
  eventTickets     EventTicket[]
  eventCheckIns    EventCheckIn[]
  eventSpeakers    EventSpeaker[]
  eventAttachments EventAttachment[]
  eventResources   EventResource[]
  eventMinistries  EventMinistry[]
  eventWaitlist    EventWaitlistEntry[]
  eventActivities  EventActivity[]
  eventMessages    EventMessage[]
  communicationTemplates CommunicationTemplate[]
  communicationCampaigns CommunicationCampaign[]
  communicationMessages  CommunicationMessage[]
  communicationDeliveries CommunicationDelivery[]
  communicationAutomations CommunicationAutomation[]
  communicationActivities CommunicationActivity[]
  communicationProviders CommunicationProviderConfig[]

  @@index([slug])
  @@map("organizations")
}

/// Links a User to an Organization with an RBAC role.
model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           Role             @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, role])
  @@map("memberships")
}

// =============================================================================
// CRM — Members
// =============================================================================

enum MemberStatus {
  ACTIVE
  VISITOR
  INACTIVE
  NEW_MEMBER
  TRANSFERRED
  DECEASED
}

enum MemberLifecycle {
  PROSPECT
  VISITOR
  REGULAR
  MEMBER
  LEADER
  ALUMNI
}

enum Gender {
  FEMALE
  MALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MaritalStatus {
  SINGLE
  MARRIED
  WIDOWED
  DIVORCED
  SEPARATED
  UNKNOWN
}

enum NoteVisibility {
  PRIVATE
  PASTORAL
  LEADER
}

enum DocumentType {
  ID
  CERTIFICATE
  BAPTISM
  MEMBERSHIP
  OTHER
}

enum ActivityType {
  CREATED
  EDITED
  VISITED
  ATTENDED
  PRAYER_REQUESTED
  BAPTIZED
  FOUNDATION_COURSE_COMPLETED
  VOLUNTEER_JOINED
  NOTE_ADDED
  DOCUMENT_UPLOADED
  TAG_ADDED
  TAG_REMOVED
  FAMILY_LINKED
  EMAIL_SENT
  CALL_LOGGED
  WHATSAPP_SENT
  LEADER_ASSIGNED
  STATUS_CHANGED
  IMPORTED
}

enum FamilyRelation {
  HEAD
  HUSBAND
  WIFE
  SPOUSE
  SON
  DAUGHTER
  CHILD
  PARENT
  GRANDPARENT
  GUARDIAN
  SIBLING
  RELATIVE
  OTHER
}

enum HouseholdStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum HouseholdActivityType {
  CREATED
  EDITED
  MEMBER_ADDED
  MEMBER_REMOVED
  MEMBER_MOVED
  RELATION_CHANGED
  HEAD_CHANGED
  MERGED
  SPLIT
  VISITED
  EMAIL_SENT
  WHATSAPP_SENT
  PRAYER_REQUESTED
  CELL_LEADER_ASSIGNED
  HOME_VISIT_SCHEDULED
  NOTE_ADDED
  DOCUMENT_UPLOADED
  IMPORTED
  STATUS_CHANGED
}

enum AttendanceMethod {
  MANUAL
  QR
  IMPORT
  SEARCH
  HOUSEHOLD
  VISITOR
  VOLUNTEER
}

enum AttendanceSessionType {
  SUNDAY
  YOUTH
  PRAYER
  CELL_GROUP
  EVENT
  VOLUNTEER
  OTHER
}

enum AttendanceSessionStatus {
  SCHEDULED
  LIVE
  CLOSED
  CANCELLED
}

enum AttendanceCheckStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum PrayerStatus {
  OPEN
  PRAYING
  ANSWERED
  ARCHIVED
}

enum VolunteerStatus {
  ACTIVE
  PAUSED
  ENDED
}

/// Congregant CRM record (distinct from platform Membership / Role.MEMBER).
model Member {
  id               String          @id @default(cuid())
  organizationId   String
  firstName        String
  lastName         String
  email            String?
  phone            String?
  whatsapp         String?
  avatarUrl        String?
  coverUrl         String?
  status           MemberStatus    @default(VISITOR)
  lifecycle        MemberLifecycle @default(VISITOR)
  gender           Gender?
  maritalStatus    MaritalStatus   @default(UNKNOWN)
  dateOfBirth      DateTime?
  baptismDate      DateTime?
  joinedAt         DateTime?
  campus           String?
  ministryRole     String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  postalCode       String?
  country          String?
  emergencyName    String?
  emergencyPhone   String?
  emergencyRelation String?
  assignedLeaderId String?
  linkedUserId     String?
  engagementScore  Int             @default(0)
  growthScore      Int             @default(0)
  riskScore        Int             @default(0)
  aiSummary        String?
  aiInsights       Json?
  qrToken          String          @unique @default(cuid())
  customFields     Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedLeader Member?    @relation("MemberLeader", fields: [assignedLeaderId], references: [id], onDelete: SetNull)
  ledMembers     Member[]   @relation("MemberLeader")

  tags          MemberTag[]
  householdLinks HouseholdMembership[]
  notes         MemberNote[]
  documents     MemberDocument[]
  activities    MemberActivity[]
  attendance    AttendanceRecord[]
  giving        GivingRecord[]
  prayers       PrayerRequest[]
  volunteers    VolunteerAssignment[]
  volunteerProfile VolunteerProfile?

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, lastName, firstName])
  @@index([organizationId, email])
  @@index([organizationId, deletedAt])
  @@index([organizationId, lifecycle])
  @@index([organizationId, createdAt])
  @@index([organizationId, campus])
  @@index([assignedLeaderId])
  @@index([qrToken])
  @@map("members")
}

model Tag {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  color          String   @default("#0d9488")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      MemberTag[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("tags")
}

model MemberTag {
  id        String   @id @default(cuid())
  memberId  String
  tagId     String
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([memberId, tagId])
  @@index([tagId])
  @@map("member_tags")
}

/// Central family unit for pastoral care, attendance, giving, and relationships.
model Household {
  id                 String          @id @default(cuid())
  organizationId     String
  familyName         String
  householdCode      String
  addressLine1       String?
  addressLine2       String?
  city               String?
  state              String?
  postalCode         String?
  country            String?
  geoLatitude        Float?
  geoLongitude       Float?
  preferredLanguage  String?
  anniversaryDate    DateTime?
  emergencyContact   String?
  emergencyPhone     String?
  photoUrl           String?
  notes              String?
  status             HouseholdStatus @default(ACTIVE)
  cellGroup          String?
  assignedCellLeaderId String?
  engagementScore    Int             @default(0)
  qrToken            String          @unique @default(cuid())
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  HouseholdMembership[]
  activities   HouseholdActivity[]
  householdNotes HouseholdNote[]
  documents    HouseholdDocument[]
  attendanceRecords AttendanceRecord[]

  @@unique([organizationId, householdCode])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, familyName])
  @@index([organizationId, deletedAt])
  @@index([organizationId, cellGroup])
  @@index([organizationId, engagementScore])
  @@index([assignedCellLeaderId])
  @@index([qrToken])
  @@map("households")
}

/// Links a Member to a Household with a family relationship (HouseholdMembership).
model HouseholdMembership {
  id          String         @id @default(cuid())
  householdId String
  memberId    String
  relation    FamilyRelation @default(OTHER)
  isPrimary   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([householdId, memberId])
  @@unique([memberId])
  @@index([householdId])
  @@index([memberId])
  @@map("family_members")
}

model HouseholdActivity {
  id             String                @id @default(cuid())
  organizationId String
  householdId    String
  type           HouseholdActivityType
  title          String
  description    String?
  metadata       Json?
  actorUserId    String?
  occurredAt     DateTime              @default(now())
  createdAt      DateTime              @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  household    Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([organizationId, householdId, occurredAt])
  @@map("household_activities")
}

model HouseholdNote {
  id             String         @id @default(cuid())
  organizationId String
  householdId    String
  authorUserId   String
  visibility     NoteVisibility @default(PRIVATE)
  body           String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  household    Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([organizationId, householdId])
  @@map("household_notes")
}

model HouseholdDocument {
  id             String       @id @default(cuid())
  organizationId String
  householdId    String
  type           DocumentType @default(OTHER)
  name           String
  mimeType       String
  sizeBytes      Int
  storageKey     String
  url            String?
  uploadedById   String?
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  household    Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([organizationId, householdId])
  @@map("household_documents")
}

model SavedHouseholdFilter {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  name           String
  definition     Json
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@map("saved_household_filters")
}

model HouseholdListPreference {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  columns        Json
  density        String   @default("comfortable")
  viewMode       String   @default("table")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("household_list_preferences")
}

model MemberNote {
  id             String         @id @default(cuid())
  organizationId String
  memberId       String
  authorUserId   String
  visibility     NoteVisibility @default(PRIVATE)
  body           String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  author       User         @relation("NoteAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([organizationId, memberId])
  @@index([memberId, visibility])
  @@map("member_notes")
}

model MemberDocument {
  id             String       @id @default(cuid())
  organizationId String
  memberId       String
  type           DocumentType @default(OTHER)
  name           String
  mimeType       String
  sizeBytes      Int
  storageKey     String
  url            String?
  uploadedById   String?
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([organizationId, memberId])
  @@map("member_documents")
}

model MemberActivity {
  id             String       @id @default(cuid())
  organizationId String
  memberId       String
  type           ActivityType
  title          String
  description    String?
  metadata       Json?
  actorUserId    String?
  occurredAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  actor        User?        @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, memberId, occurredAt])
  @@index([memberId, type])
  @@map("member_activities")
}

model AttendanceSession {
  id               String                  @id @default(cuid())
  organizationId   String
  serviceName      String
  campus           String?
  ministry         String?
  date             DateTime
  startTime        DateTime?
  endTime          DateTime?
  attendanceType   AttendanceSessionType   @default(SUNDAY)
  status           AttendanceSessionStatus @default(SCHEDULED)
  expectedCount    Int?
  notes            String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records            AttendanceRecord[]
  visitorAttendances VisitorAttendance[]

  @@index([organizationId, date])
  @@index([organizationId, status])
  @@index([organizationId, attendanceType])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id                 String                @id @default(cuid())
  organizationId     String
  sessionId          String?
  memberId           String
  householdId        String?
  eventName          String
  attendedAt         DateTime
  checkedInByUserId  String?
  method             AttendanceMethod      @default(MANUAL)
  attendanceStatus   AttendanceCheckStatus @default(PRESENT)
  notes              String?
  createdAt          DateTime              @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  session      AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  household    Household?         @relation(fields: [householdId], references: [id], onDelete: SetNull)

  @@unique([sessionId, memberId])
  @@index([organizationId, memberId, attendedAt])
  @@index([organizationId, sessionId])
  @@index([organizationId, householdId, attendedAt])
  @@index([householdId])
  @@map("attendance_records")
}

enum VisitorPipelineStage {
  FIRST_VISIT
  WELCOME_SENT
  ASSIGNED_LEADER
  CONTACTED
  SECOND_VISIT
  CELL_GROUP_INVITED
  FOUNDATION_COURSE
  MEMBERSHIP_INTERVIEW
  MEMBER
}

enum FollowUpTaskType {
  CALL
  WHATSAPP
  EMAIL_WELCOME
  INVITE_SERVICE
  INVITE_CELL
  HOME_VISIT
  CUSTOM
}

enum FollowUpTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
  SNOOZED
}

enum FollowUpPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CommunicationChannel {
  PHONE
  EMAIL
  WHATSAPP
  SMS
  IN_PERSON
  NOTE
}

enum CommunicationDirection {
  OUTBOUND
  INBOUND
}

enum VisitorActivityType {
  CREATED
  STAGE_CHANGED
  LEADER_ASSIGNED
  TASK_CREATED
  TASK_COMPLETED
  COMMUNICATION
  ATTENDED
  NOTE_ADDED
  CONVERTED
  AUTOMATION
}

/// First-time / returning visitor profile — Attendance check-in + Journey pipeline.
model Visitor {
  id                 String               @id @default(cuid())
  organizationId     String
  firstName          String
  lastName           String
  phone              String?
  email              String?
  invitedByMemberId  String?
  householdId        String?
  familyName         String?
  childrenCount      Int                  @default(0)
  prayerRequest      String?
  notes              String?
  convertedMemberId  String?
  status             VisitorPipelineStage @default(FIRST_VISIT)
  assignedLeaderId   String?
  assignedUserId     String?
  stageEnteredAt     DateTime             @default(now())
  source             String?
  preferredChannel   CommunicationChannel?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attendances    VisitorAttendance[]
  journey        VisitorJourney?
  statusHistory  VisitorStatusHistory[]
  tasks          FollowUpTask[]
  communications CommunicationLog[]
  activities     VisitorActivity[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@index([organizationId, stageEnteredAt])
  @@index([organizationId, createdAt])
  @@index([assignedLeaderId])
  @@index([assignedUserId])
  @@map("visitors")
}

model VisitorAttendance {
  id                  String   @id @default(cuid())
  organizationId      String
  visitorId           String
  sessionId           String
  invitedByMemberId   String?
  isFirstVisit        Boolean  @default(true)
  isSecondVisit       Boolean  @default(false)
  convertedToMember   Boolean  @default(false)
  checkedInAt         DateTime @default(now())
  notes               String?
  createdAt           DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  visitor      Visitor           @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  session      AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, visitorId])
  @@index([organizationId, sessionId])
  @@index([visitorId])
  @@map("visitor_attendances")
}

/// Active journey instance for a visitor (one per visitor).
model VisitorJourney {
  id                 String               @id @default(cuid())
  organizationId     String
  visitorId          String               @unique
  currentStage       VisitorPipelineStage @default(FIRST_VISIT)
  startedAt          DateTime             @default(now())
  completedAt        DateTime?
  convertedAt        DateTime?
  conversionMemberId String?
  metadata           Json?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  visitor      Visitor      @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([organizationId, currentStage])
  @@map("visitor_journeys")
}

/// Org-configurable pipeline stages (automation-ready).
model VisitorStageConfig {
  id             String               @id @default(cuid())
  organizationId String
  stageKey       VisitorPipelineStage
  label          String
  sortOrder      Int
  isActive       Boolean              @default(true)
  /// Auto task types to spawn when entering this stage (JSON string array of FollowUpTaskType)
  autoTaskTypes  Json?
  slaHours       Int?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, stageKey])
  @@index([organizationId, sortOrder])
  @@map("visitor_stage_configs")
}

model FollowUpTask {
  id             String            @id @default(cuid())
  organizationId String
  visitorId      String
  type           FollowUpTaskType  @default(CUSTOM)
  title          String
  description    String?
  ownerUserId    String?
  dueAt          DateTime?
  priority       FollowUpPriority  @default(MEDIUM)
  status         FollowUpTaskStatus @default(OPEN)
  notes          String?
  completedAt    DateTime?
  /// Stable key for automation idempotency (e.g. "welcome_email:visitorId")
  automationKey  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  visitor      Visitor      @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@unique([organizationId, automationKey])
  @@index([organizationId, status, dueAt])
  @@index([visitorId])
  @@index([ownerUserId])
  @@map("follow_up_tasks")
}

model CommunicationLog {
  id             String                 @id @default(cuid())
  organizationId String
  visitorId      String
  channel        CommunicationChannel
  direction      CommunicationDirection @default(OUTBOUND)
  subject        String?
  body           String
  actorUserId    String?
  occurredAt     DateTime               @default(now())
  /// Future provider payload (Twilio/SendGrid/etc.)
  metadata       Json?
  createdAt      DateTime               @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  visitor      Visitor      @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([organizationId, visitorId, occurredAt])
  @@index([visitorId])
  @@map("communication_logs")
}

model VisitorStatusHistory {
  id              String                @id @default(cuid())
  organizationId  String
  visitorId       String
  fromStatus      VisitorPipelineStage?
  toStatus        VisitorPipelineStage
  changedByUserId String?
  note            String?
  occurredAt      DateTime              @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  visitor      Visitor      @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([organizationId, visitorId, occurredAt])
  @@map("visitor_status_history")
}

model VisitorActivity {
  id             String              @id @default(cuid())
  organizationId String
  visitorId      String
  type           VisitorActivityType
  title          String
  description    String?
  actorUserId    String?
  metadata       Json?
  occurredAt     DateTime            @default(now())
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  visitor      Visitor      @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([organizationId, visitorId, occurredAt])
  @@map("visitor_activities")
}

model GivingRecord {
  id             String   @id @default(cuid())
  organizationId String
  memberId       String
  amountCents    Int
  fund           String   @default("General")
  givenAt        DateTime
  notes          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([organizationId, memberId, givenAt])
  @@map("giving_records")
}

model PrayerRequest {
  id             String       @id @default(cuid())
  organizationId String
  memberId       String
  request        String
  status         PrayerStatus @default(OPEN)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  answeredAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([organizationId, memberId])
  @@index([organizationId, status])
  @@map("prayer_requests")
}

model VolunteerAssignment {
  id             String          @id @default(cuid())
  organizationId String
  memberId       String
  roleName       String
  team           String?
  status         VolunteerStatus @default(ACTIVE)
  startedAt      DateTime        @default(now())
  endedAt        DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([organizationId, memberId])
  @@map("volunteer_assignments")
}

model SavedMemberFilter {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  name           String
  definition     Json
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@map("saved_member_filters")
}

model MemberListPreference {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  columns        Json
  density        String   @default("comfortable")
  viewMode       String   @default("table")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("member_list_preferences")
}

// =============================================================================
// Ministry & Volunteer Management
// =============================================================================

enum MinistryStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum TrainingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum ScheduleEventType {
  SUNDAY_SERVICE
  CONFERENCE
  YOUTH_NIGHT
  PRAYER_MEETING
  SPECIAL_EVENT
  OTHER
}

enum ScheduleAssignmentStatus {
  ASSIGNED
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum SwapRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum VolunteerCheckInStatus {
  CHECKED_IN
  LATE
  ABSENT
  EXCUSED
}

enum VolunteerMessageChannel {
  EMAIL
  WHATSAPP
  SMS
  IN_APP
}

enum VolunteerActivityType {
  CREATED
  UPDATED
  ASSIGNED
  CONFIRMED
  DECLINED
  SWAP_REQUESTED
  SWAP_ACCEPTED
  CHECKED_IN
  MESSAGE_SENT
  TRAINING_UPDATED
}

enum Weekday {
  SUN
  MON
  TUE
  WED
  THU
  FRI
  SAT
}

model Ministry {
  id               String         @id @default(cuid())
  organizationId   String
  name             String
  slug             String
  description      String?
  color            String         @default("#0d9488")
  icon             String?
  status           MinistryStatus @default(ACTIVE)
  leaderMemberId   String?
  sortOrder        Int            @default(0)
  isDefault        Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roles        MinistryRole[]
  events       ScheduleEvent[]
  preferences  VolunteerMinistryPreference[]
  messages     VolunteerMessage[]
  eventMinistries EventMinistry[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@map("ministries")
}

model MinistryRole {
  id             String   @id @default(cuid())
  organizationId String
  ministryId     String
  name           String
  description    String?
  slotsNeeded    Int      @default(1)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ministry     Ministry     @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  slots        ScheduleSlot[]

  @@index([organizationId, ministryId])
  @@map("ministry_roles")
}

model VolunteerProfile {
  id                  String         @id @default(cuid())
  organizationId      String
  memberId            String         @unique
  experienceYears     Int?
  trainingStatus      TrainingStatus @default(NOT_STARTED)
  preferredService    String?
  emergencyName       String?
  emergencyPhone      String?
  notes               String?
  reliabilityScore    Int            @default(80)
  totalHours          Float          @default(0)
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization    Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member          Member                         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  skills          VolunteerSkill[]
  certifications  VolunteerCertification[]
  availabilities  VolunteerAvailability[]
  preferences     VolunteerMinistryPreference[]
  assignments     ScheduleAssignment[]
  checkIns        VolunteerCheckIn[]
  activities      VolunteerActivity[]
  messages        VolunteerMessage[]
  swapRequestsFrom ScheduleSwapRequest[]         @relation("SwapFrom")
  swapRequestsTo   ScheduleSwapRequest[]         @relation("SwapTo")

  @@index([organizationId, isActive])
  @@map("volunteer_profiles")
}

model VolunteerSkill {
  id             String   @id @default(cuid())
  organizationId String
  volunteerId    String
  name           String
  level          String?
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  volunteer    VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@index([volunteerId])
  @@map("volunteer_skills")
}

model VolunteerCertification {
  id             String    @id @default(cuid())
  organizationId String
  volunteerId    String
  name           String
  issuer         String?
  issuedAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  volunteer    VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@index([volunteerId])
  @@map("volunteer_certifications")
}

model VolunteerAvailability {
  id             String   @id @default(cuid())
  organizationId String
  volunteerId    String
  weekday        Weekday
  startTime      String
  endTime        String
  notes          String?
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  volunteer    VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@index([volunteerId])
  @@map("volunteer_availabilities")
}

model VolunteerMinistryPreference {
  id             String   @id @default(cuid())
  organizationId String
  volunteerId    String
  ministryId     String
  priority       Int      @default(1)
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  volunteer    VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  ministry     Ministry        @relation(fields: [ministryId], references: [id], onDelete: Cascade)

  @@unique([volunteerId, ministryId])
  @@index([organizationId, ministryId])
  @@map("volunteer_ministry_preferences")
}

model ScheduleEvent {
  id             String            @id @default(cuid())
  organizationId String
  ministryId     String?
  title          String
  eventType      ScheduleEventType @default(SUNDAY_SERVICE)
  campus         String?
  startsAt       DateTime
  endsAt         DateTime?
  location       String?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ministry     Ministry?    @relation(fields: [ministryId], references: [id], onDelete: SetNull)
  slots        ScheduleSlot[]

  @@index([organizationId, startsAt])
  @@index([ministryId])
  @@map("schedule_events")
}

model ScheduleSlot {
  id             String   @id @default(cuid())
  organizationId String
  eventId        String
  roleId         String?
  title          String
  needed         Int      @default(1)
  startsAt       DateTime
  endsAt         DateTime?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        ScheduleEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  role         MinistryRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  assignments  ScheduleAssignment[]

  @@index([organizationId, eventId])
  @@map("schedule_slots")
}

model ScheduleAssignment {
  id             String                   @id @default(cuid())
  organizationId String
  slotId         String
  volunteerId    String
  status         ScheduleAssignmentStatus @default(ASSIGNED)
  notes          String?
  assignedAt     DateTime                 @default(now())
  respondedAt    DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slot         ScheduleSlot     @relation(fields: [slotId], references: [id], onDelete: Cascade)
  volunteer    VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  checkIns     VolunteerCheckIn[]
  swapFrom     ScheduleSwapRequest[] @relation("SwapAssignmentFrom")
  swapTo       ScheduleSwapRequest[] @relation("SwapAssignmentTo")

  @@unique([slotId, volunteerId])
  @@index([organizationId, volunteerId])
  @@index([slotId, status])
  @@map("schedule_assignments")
}

model ScheduleSwapRequest {
  id                 String           @id @default(cuid())
  organizationId     String
  fromAssignmentId   String
  toAssignmentId     String?
  fromVolunteerId    String
  toVolunteerId      String?
  status             SwapRequestStatus @default(PENDING)
  message            String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  resolvedAt         DateTime?

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromAssignment ScheduleAssignment @relation("SwapAssignmentFrom", fields: [fromAssignmentId], references: [id], onDelete: Cascade)
  toAssignment   ScheduleAssignment? @relation("SwapAssignmentTo", fields: [toAssignmentId], references: [id], onDelete: SetNull)
  fromVolunteer  VolunteerProfile  @relation("SwapFrom", fields: [fromVolunteerId], references: [id], onDelete: Cascade)
  toVolunteer    VolunteerProfile? @relation("SwapTo", fields: [toVolunteerId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@map("schedule_swap_requests")
}

model VolunteerCheckIn {
  id             String                 @id @default(cuid())
  organizationId String
  volunteerId    String
  assignmentId   String?
  status         VolunteerCheckInStatus @default(CHECKED_IN)
  checkedInAt    DateTime               @default(now())
  notes          String?
  createdAt      DateTime               @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  volunteer    VolunteerProfile  @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  assignment   ScheduleAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([organizationId, volunteerId, checkedInAt])
  @@map("volunteer_check_ins")
}

model VolunteerMessage {
  id             String                  @id @default(cuid())
  organizationId String
  volunteerId    String?
  ministryId     String?
  channel        VolunteerMessageChannel @default(IN_APP)
  subject        String?
  body           String
  actorUserId    String?
  metadata       Json?
  sentAt         DateTime                @default(now())
  createdAt      DateTime                @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  volunteer    VolunteerProfile? @relation(fields: [volunteerId], references: [id], onDelete: SetNull)
  ministry     Ministry?        @relation(fields: [ministryId], references: [id], onDelete: SetNull)

  @@index([organizationId, sentAt])
  @@map("volunteer_messages")
}

model VolunteerActivity {
  id             String                @id @default(cuid())
  organizationId String
  volunteerId    String
  type           VolunteerActivityType
  title          String
  description    String?
  actorUserId    String?
  metadata       Json?
  occurredAt     DateTime              @default(now())
  createdAt      DateTime              @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  volunteer    VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@index([organizationId, volunteerId, occurredAt])
  @@map("volunteer_activities")
}

// =============================================================================
// Enterprise Events & Church Calendar
// =============================================================================

enum ChurchEventType {
  SUNDAY_SERVICE
  YOUTH_SERVICE
  PRAYER_MEETING
  BIBLE_STUDY
  CELL_GROUP
  CONFERENCE
  RETREAT
  WEDDING
  FUNERAL
  OUTREACH
  TRAINING
  CHILDREN_EVENT
  VOLUNTEER_MEETING
  CUSTOM
}

enum ChurchEventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
  ARCHIVED
}

enum EventVisibility {
  PUBLIC
  MEMBERS
  INVITE_ONLY
  PRIVATE
}

enum RecurrenceFrequency {
  NONE
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

enum RegistrationStatus {
  REGISTERED
  WAITLISTED
  CANCELLED
  CHECKED_IN
  NO_SHOW
}

enum RegistrantType {
  MEMBER
  VISITOR
  HOUSEHOLD
  GUEST
  GROUP
}

enum EventTicketStatus {
  VALID
  USED
  REVOKED
  EXPIRED
}

enum EventResourceType {
  ROOM
  EQUIPMENT
  VEHICLE
  OTHER
}

enum EventActivityType {
  CREATED
  UPDATED
  PUBLISHED
  CANCELLED
  REGISTRATION
  WAITLIST
  CHECKED_IN
  MESSAGE_QUEUED
  VOLUNTEER_LINKED
  ATTACHMENT_ADDED
}

enum EventMessageChannel {
  EMAIL
  WHATSAPP
  SMS
  PUSH
  IN_APP
}

/// Operational church calendar event (distinct from ministry ScheduleEvent staffing).
model ChurchEvent {
  id                String            @id @default(cuid())
  organizationId    String
  title             String
  slug              String
  description       String?
  heroImageUrl      String?
  eventType         ChurchEventType   @default(CUSTOM)
  status            ChurchEventStatus @default(DRAFT)
  visibility        EventVisibility   @default(MEMBERS)
  startsAt          DateTime
  endsAt            DateTime?
  timezone          String            @default("UTC")
  allDay            Boolean           @default(false)
  venueName         String?
  venueAddress      String?
  campus            String?
  capacity          Int?
  registrationOpen  Boolean           @default(true)
  waitlistEnabled   Boolean           @default(true)
  requiresTicket    Boolean           @default(true)
  organizerMemberId String?
  organizerUserId   String?
  recurrence        RecurrenceFrequency @default(NONE)
  recurrenceRule    String?
  recurrenceUntil   DateTime?
  parentEventId     String?
  scheduleEventId   String?
  checkInCode       String            @unique @default(cuid())
  notes             String?
  publishedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       ChurchEvent? @relation("EventSeries", fields: [parentEventId], references: [id], onDelete: SetNull)
  children     ChurchEvent[] @relation("EventSeries")
  registrations EventRegistration[]
  tickets      EventTicket[]
  checkIns     EventCheckIn[]
  speakers     EventSpeaker[]
  attachments  EventAttachment[]
  resources    EventResource[]
  ministries   EventMinistry[]
  waitlist     EventWaitlistEntry[]
  activities   EventActivity[]
  messages     EventMessage[]

  @@unique([organizationId, slug])
  @@index([organizationId, startsAt])
  @@index([organizationId, status])
  @@index([organizationId, eventType])
  @@index([organizationId, deletedAt])
  @@index([organizationId, deletedAt, startsAt])
  @@index([checkInCode])
  @@map("church_events")
}

model EventRegistration {
  id               String             @id @default(cuid())
  organizationId   String
  eventId          String
  registrantType   RegistrantType     @default(MEMBER)
  memberId         String?
  visitorId        String?
  householdId      String?
  guestName        String?
  guestEmail       String?
  guestPhone       String?
  partySize        Int                @default(1)
  status           RegistrationStatus @default(REGISTERED)
  notes            String?
  registeredAt     DateTime           @default(now())
  cancelledAt      DateTime?
  checkedInAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        ChurchEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets      EventTicket[]
  checkIns     EventCheckIn[]

  @@index([organizationId, eventId, status])
  @@index([eventId, memberId])
  @@index([eventId, visitorId])
  @@index([householdId])
  @@map("event_registrations")
}

model EventTicket {
  id               String            @id @default(cuid())
  organizationId   String
  eventId          String
  registrationId   String
  qrToken          String            @unique @default(cuid())
  status           EventTicketStatus @default(VALID)
  holderName       String?
  issuedAt         DateTime          @default(now())
  usedAt           DateTime?
  createdAt        DateTime          @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        ChurchEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  checkIns     EventCheckIn[]

  @@index([organizationId, eventId])
  @@index([qrToken])
  @@map("event_tickets")
}

model EventCheckIn {
  id               String   @id @default(cuid())
  organizationId   String
  eventId          String
  registrationId   String?
  ticketId         String?
  memberId         String?
  method           String   @default("QR")
  checkedInAt      DateTime @default(now())
  checkedInByUserId String?
  notes            String?
  createdAt        DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        ChurchEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration EventRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  ticket       EventTicket?       @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@unique([eventId, ticketId])
  @@index([organizationId, eventId, checkedInAt])
  @@index([eventId, memberId])
  @@map("event_check_ins")
}

model EventSpeaker {
  id             String   @id @default(cuid())
  organizationId String
  eventId        String
  memberId       String?
  name           String
  title          String?
  bio            String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        ChurchEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_speakers")
}

model EventAttachment {
  id             String   @id @default(cuid())
  organizationId String
  eventId        String
  name           String
  mimeType       String
  sizeBytes      Int
  url            String?
  storageKey     String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        ChurchEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_attachments")
}

model EventResource {
  id             String           @id @default(cuid())
  organizationId String
  eventId        String
  type           EventResourceType @default(OTHER)
  name           String
  quantity       Int              @default(1)
  notes          String?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        ChurchEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_resources")
}

model EventMinistry {
  id             String   @id @default(cuid())
  organizationId String
  eventId        String
  ministryId     String
  notes          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        ChurchEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ministry     Ministry     @relation(fields: [ministryId], references: [id], onDelete: Cascade)

  @@unique([eventId, ministryId])
  @@index([ministryId])
  @@map("event_ministries")
}

model EventWaitlistEntry {
  id             String   @id @default(cuid())
  organizationId String
  eventId        String
  memberId       String?
  visitorId      String?
  guestName      String?
  guestEmail     String?
  guestPhone     String?
  partySize      Int      @default(1)
  position       Int
  promotedAt     DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        ChurchEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, position])
  @@map("event_waitlist")
}

model EventActivity {
  id             String            @id @default(cuid())
  organizationId String
  eventId        String
  type           EventActivityType
  title          String
  description    String?
  actorUserId    String?
  metadata       Json?
  occurredAt     DateTime          @default(now())
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        ChurchEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([organizationId, eventId, occurredAt])
  @@map("event_activities")
}

model EventMessage {
  id             String             @id @default(cuid())
  organizationId String
  eventId        String
  channel        EventMessageChannel @default(IN_APP)
  subject        String?
  body           String
  actorUserId    String?
  /// Future provider payload (SendGrid/Twilio/FCM)
  metadata       Json?
  scheduledFor   DateTime?
  sentAt         DateTime?
  createdAt      DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        ChurchEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([organizationId, eventId, createdAt])
  @@map("event_messages")
}

// =============================================================================
// Enterprise Communication Hub
// =============================================================================

enum HubChannel {
  EMAIL
  WHATSAPP
  SMS
  PUSH
  INTERNAL
}

enum HubMessageStatus {
  DRAFT
  SCHEDULED
  QUEUED
  SENDING
  SENT
  FAILED
  ARCHIVED
}

enum HubMessageDirection {
  OUTBOUND
  INBOUND
}

enum HubAudienceType {
  ALL_MEMBERS
  VISITORS
  HOUSEHOLDS
  CELL_GROUPS
  VOLUNTEERS
  MINISTRY
  EVENT_REGISTRANTS
  CUSTOM
}

enum HubAutomationTrigger {
  NEW_VISITOR
  BIRTHDAY
  ANNIVERSARY
  EVENT_REMINDER
  VOLUNTEER_ASSIGNMENT
  ATTENDANCE_MISSED
  PRAYER_ASSIGNED
  MEMBERSHIP_APPROVED
  FOLLOW_UP_TASK_DUE
}

enum HubDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  OPENED
  CLICKED
  FAILED
  BOUNCED
}

enum HubProviderKind {
  RESEND
  TWILIO
  WHATSAPP_BUSINESS
  FIREBASE
  INTERNAL
}

enum HubActivityType {
  CREATED
  UPDATED
  SCHEDULED
  QUEUED
  SENT
  FAILED
  ARCHIVED
  TEMPLATE_USED
  AUTOMATION_FIRED
  DELIVERY_UPDATED
}

model CommunicationTemplate {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  slug           String
  channel        HubChannel
  subject        String?
  body           String
  variables      String[]   @default([])
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns    CommunicationCampaign[]
  messages     CommunicationMessage[]
  automations  CommunicationAutomation[]

  @@unique([organizationId, slug])
  @@index([organizationId, channel])
  @@map("communication_templates")
}

model CommunicationCampaign {
  id               String          @id @default(cuid())
  organizationId   String
  name             String
  description      String?
  channel          HubChannel
  audienceType     HubAudienceType @default(ALL_MEMBERS)
  /// Filter payload: ministryId, eventId, cellGroup, memberIds, tagSlugs, etc.
  audienceFilter   Json?
  templateId       String?
  subject          String?
  body             String
  status           HubMessageStatus @default(DRAFT)
  scheduledFor     DateTime?
  sentAt           DateTime?
  createdByUserId  String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     CommunicationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  messages     CommunicationMessage[]
  deliveries   CommunicationDelivery[]
  activities   CommunicationActivity[]

  @@index([organizationId, status])
  @@index([organizationId, scheduledFor])
  @@map("communication_campaigns")
}

/// Unified inbox / outbox message unit (campaign child or standalone).
model CommunicationMessage {
  id               String              @id @default(cuid())
  organizationId   String
  campaignId       String?
  templateId       String?
  channel          HubChannel
  direction        HubMessageDirection @default(OUTBOUND)
  status           HubMessageStatus    @default(DRAFT)
  subject          String?
  body             String
  audienceType     HubAudienceType?
  audienceFilter   Json?
  /// Provider adapter metadata { provider, queued, externalId, error }
  metadata         Json?
  scheduledFor     DateTime?
  sentAt           DateTime?
  failedAt         DateTime?
  failureReason    String?
  createdByUserId  String?
  memberId         String?
  visitorId        String?
  householdId      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     CommunicationCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  template     CommunicationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  deliveries   CommunicationDelivery[]
  activities   CommunicationActivity[]

  @@index([organizationId, status, createdAt])
  @@index([organizationId, direction, createdAt])
  @@index([organizationId, channel])
  @@index([campaignId])
  @@index([memberId])
  @@index([visitorId])
  @@index([householdId])
  @@map("communication_messages")
}

model CommunicationDelivery {
  id               String            @id @default(cuid())
  organizationId   String
  messageId        String
  campaignId       String?
  channel          HubChannel
  status           HubDeliveryStatus @default(PENDING)
  recipientName    String?
  recipientEmail   String?
  recipientPhone   String?
  memberId         String?
  visitorId        String?
  householdId      String?
  provider         HubProviderKind   @default(INTERNAL)
  externalId       String?
  /// Provider response / tracking payload
  metadata         Json?
  errorMessage     String?
  sentAt           DateTime?
  deliveredAt      DateTime?
  openedAt         DateTime?
  clickedAt        DateTime?
  failedAt         DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  message      CommunicationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  campaign     CommunicationCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([messageId])
  @@index([campaignId])
  @@index([memberId])
  @@index([visitorId])
  @@index([householdId])
  @@map("communication_deliveries")
}

model CommunicationAutomation {
  id             String               @id @default(cuid())
  organizationId String
  name           String
  trigger        HubAutomationTrigger
  channel        HubChannel
  templateId     String?
  subject        String?
  body           String
  isActive       Boolean              @default(true)
  /// Delay minutes after trigger, filters, etc.
  config         Json?
  lastFiredAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     CommunicationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([organizationId, trigger, isActive])
  @@map("communication_automations")
}

model CommunicationActivity {
  id             String         @id @default(cuid())
  organizationId String
  type           HubActivityType
  title          String
  description    String?
  actorUserId    String?
  campaignId     String?
  messageId      String?
  metadata       Json?
  occurredAt     DateTime       @default(now())
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     CommunicationCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  message      CommunicationMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([campaignId])
  @@index([messageId])
  @@map("communication_activities")
}

model CommunicationProviderConfig {
  id             String          @id @default(cuid())
  organizationId String
  provider       HubProviderKind
  channel        HubChannel
  isEnabled      Boolean         @default(false)
  /// Non-secret config (from/region). Secrets stay in env.
  config         Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, channel])
  @@map("communication_provider_configs")
}
